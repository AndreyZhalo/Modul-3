<Window x:Class="Modul_3.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Modul_3.Converters"
        xmlns:views="clr-namespace:Modul_3.Views"
        Title="Контроль распайки разъемов" Height="700" Width="1496"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="1000" MinHeight="600">

    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Grid Margin="0,0,10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="322*"/>
            <RowDefinition Height="363*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="437"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - список разъемов -->
        <StackPanel Grid.Column="0" Background="#F5F5F5" Grid.ColumnSpan="3" Grid.RowSpan="2" Margin="0,0,978,0">
            <TextBlock Text="Разъемы изделия" 
                       FontWeight="Bold" 
                       FontSize="14" 
                       Margin="10,10,10,5"/>

            <ListBox ItemsSource="{Binding Connectors}"
                     DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedConnector}"
                     Margin="10,0,10,10"
                     Height="150"/>

            <Separator Margin="10,0,10,10"/>

            <!-- Панель управления размером маркера -->
            <StackPanel Margin="10" Orientation="Vertical">
                <TextBlock Text="{Binding SelectedMarker.Diameter, StringFormat='{}{0:F0}px'}" 
                           HorizontalAlignment="Center" 
                           FontSize="10"
                           IsEnabled="{Binding SelectedMarker.IsSelected}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right" Height="27">
                <TextBlock Text="Arduino Port:" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="PortsComboBox" 
              ItemsSource="{Binding AvailablePorts}"
              SelectedItem="{Binding SelectedPort}"
              Width="100" Margin="5,0"/>

                <Button Content="Обновить порты" 
            Command="{Binding RefreshPortsCommand}"
            Margin="5,0"/>

                <Button Content="Подключить" 
            Command="{Binding ConnectArduinoCommand}"
            
            Margin="5,0"/>

                <Button Content="Отключить" 
            Command="{Binding DisconnectArduinoCommand}"
            IsEnabled="{Binding IsArduinoConnected}"
            Margin="5,0"/>

                <TextBlock Text="{Binding ArduinoStatus}" 
               VerticalAlignment="Center" 
               Margin="10,0" 
               Foreground="Gray"/>
            </StackPanel>
            <StackPanel Margin="10">
                <Button Content="Добавить маркер" 
                        Command="{Binding AddMarkerCommand}"
                        Margin="0,5"
                        Height="30"/>
                <Button Content="Удалить маркер" 
                        Command="{Binding RemoveMarkerCommand}"
                        Margin="0,5"
                        Height="30"/>
                <Button Content="Загрузить изображение" 
                        Command="{Binding LoadImageCommand}"
                        Margin="0,5"
                        Height="30"/>
                <Button Content="Сохранить разметку" 
                        Command="{Binding SaveLayoutCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,10,0,5"
                        Height="35"/>
            </StackPanel>

            <!-- Подсказки -->
            <TextBlock Text="Используйте колесико мыши для изменения размера маркера" 
                       FontSize="9" 
                       FontStyle="Italic" 
                       Foreground="Gray" 
                       TextWrapping="Wrap"
                       Margin="10,10,10,0"/>
        </StackPanel>

        <!-- Правая панель - область изображения -->
        <Grid Grid.Column="2" Margin="10,10,10,10" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок выбранного разъема -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding SelectedConnector.Name, StringFormat='Разъем: {0}'}"
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <!-- Контейнер для изображения фиксированного размера -->
            <Border Grid.Row="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="800"
                    Height="600">

                <Grid x:Name="ImageContainer">
                    <!-- Изображение фиксированного размера -->
                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" 
                           Stretch="Uniform"
                           x:Name="ConnectorImage"
                           Width="800"
                           Height="600"/>

                    <!-- Canvas для маркеров - того же размера что и изображение -->
                    <Canvas x:Name="MarkersCanvas" 
                            Width="800" 
                            Height="600"
                            Background="Transparent">
                        <!-- Маркеры будут добавляться здесь в code-behind -->
                    </Canvas>
                </Grid>
            </Border>

            <!-- Подсказки и статус -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="Перетащите маркеры на нужные контакты разъема" 
                           FontStyle="Italic" 
                           Foreground="Gray"/>
                <TextBlock x:Name="StatusText" Text="" Margin="10,0,0,0" Foreground="Blue"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>