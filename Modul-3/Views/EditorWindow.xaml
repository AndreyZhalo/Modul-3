<Window x:Class="Modul_3.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Modul_3.Converters"
        xmlns:views="clr-namespace:Modul_3.Views"
        Title="Редактор разъемов" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="800" MinHeight="600">

    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - список разъемов -->
        <StackPanel Grid.Column="0" Background="#F5F5F5">
            <TextBlock Text="Разъемы изделия" 
                       FontWeight="Bold" 
                       FontSize="14" 
                       Margin="10,10,10,5"/>

            <ListBox ItemsSource="{Binding Connectors}"
                     DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedConnector}"
                     Margin="10,0,10,10"
                     Height="150"/>

            <Separator Margin="10,0,10,10"/>

            <TextBlock Text="Маркеры контактов" 
                       FontWeight="Bold" 
                       FontSize="14" 
                       Margin="10,0,10,5"/>

            <ListBox ItemsSource="{Binding Markers}"
                     SelectedItem="{Binding SelectedMarker}"
                     Margin="10,0,10,10"
                     Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Ellipse Width="12" Height="12" Margin="0,0,5,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="Green"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Fill" Value="Orange"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ContactNumber, StringFormat='Контакт {0}'}"/>
                            <TextBlock Text="{Binding ContactTag, StringFormat=' - {0}'}" 
                                       FontStyle="Italic" 
                                       Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Панель управления размером маркера -->
            <StackPanel Margin="10" Orientation="Vertical">
                <TextBlock Text="Размер маркера:" FontWeight="Bold" Margin="0,0,0,5"/>
                <Slider x:Name="MarkerSizeSlider" 
                        Minimum="10" 
                        Maximum="100" 
                        Value="{Binding SelectedMarker.Diameter, Mode=TwoWay}"
                        IsEnabled="{Binding SelectedMarker.IsSelected}"
                        Margin="0,0,0,5"/>
                <TextBlock Text="{Binding SelectedMarker.Diameter, StringFormat='{}{0:F0}px'}" 
                           HorizontalAlignment="Center" 
                           FontSize="10"
                           IsEnabled="{Binding SelectedMarker.IsSelected}"/>
            </StackPanel>

            <StackPanel Margin="10">
                <Button Content="Добавить маркер" 
                        Command="{Binding AddMarkerCommand}"
                        Margin="0,5"
                        Height="30"/>
                <Button Content="Удалить маркер" 
                        Command="{Binding RemoveMarkerCommand}"
                        Margin="0,5"
                        Height="30"/>
                <Button Content="Загрузить изображение" 
                        Command="{Binding LoadImageCommand}"
                        Margin="0,5"
                        Height="30"/>
                <Button Content="Сохранить разметку" 
                        Command="{Binding SaveLayoutCommand}"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="0,10,0,5"
                        Height="35"/>
            </StackPanel>

            <!-- Подсказки -->
            <TextBlock Text="Используйте колесико мыши для изменения размера маркера" 
                       FontSize="9" 
                       FontStyle="Italic" 
                       Foreground="Gray" 
                       TextWrapping="Wrap"
                       Margin="10,10,10,0"/>
        </StackPanel>

        <!-- Правая панель - область изображения -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок выбранного разъема -->
            <TextBlock Grid.Row="0" 
                       Text="{Binding SelectedConnector.Name, StringFormat='Разъем: {0}'}"
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>

            <!-- Контейнер для изображения фиксированного размера -->
            <Border Grid.Row="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    Background="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="800"
                    Height="600">

                <Grid x:Name="ImageContainer">
                    <!-- Изображение фиксированного размера -->
                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" 
                           Stretch="Uniform"
                           x:Name="ConnectorImage"
                           Width="800"
                           Height="600"/>

                    <!-- Canvas для маркеров - того же размера что и изображение -->
                    <Canvas x:Name="MarkersCanvas" 
                            Width="800" 
                            Height="600"
                            Background="Transparent">
                        <!-- Маркеры будут добавляться здесь в code-behind -->
                    </Canvas>
                </Grid>
            </Border>

            <!-- Подсказки и статус -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="Перетащите маркеры на нужные контакты разъема" 
                           FontStyle="Italic" 
                           Foreground="Gray"/>
                <TextBlock x:Name="StatusText" Text="" Margin="10,0,0,0" Foreground="Blue"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>